{
  "buildCommand": "prisma generate && next build",
  "regions": ["cdg1"],
  "crons": [
    {
      "path": "/api/cron/recycle-leads",
      "schedule": "*/15 * * * *"
    }
  ],
  "functions": {
    "api/**/*": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/**/*": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
